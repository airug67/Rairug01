# G A OS — Environment Configuration
# Copy this to .env and fill in your values

# Supabase (Authentication & Database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Keys (for market data integrations)
# VITE_POLYGON_API_KEY=           # Stocks / Options
# VITE_COINMARKETCAP_API_KEY=     # Crypto
# VITE_ALPHA_VANTAGE_API_KEY=     # Forex / Commodities
# VITE_OPENAI_API_KEY=            # AI Agent reasoning

# App Configuration
VITE_APP_NAME="G A OS"
VITE_APP_URL=http://localhost:3000
VITE_DEFAULT_MODE=guided